# Copy this file to .env for local development. In production, this file
# lives only on the server (e.g. /opt/yonixalpha/.env) and is NEVER committed.
# See docs/DEPLOYMENT.md for where each secret comes from and how to
# generate the ones below that need it.

# ===== APPLICATION =====
APP_ENV=development
APP_NAME=YonixAlpha
APP_PORT=8000
APP_HOST=0.0.0.0

# ===== SECURITY =====
# JWT_SECRET: generate with `openssl rand -hex 32`. Rotating this invalidates all sessions.
JWT_SECRET=
# ADMIN_USERNAME: the sole operator account for this private platform.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH: an argon2 hash, NEVER a plaintext password. Generate with:
#   python -c "from passlib.hash import argon2; print(argon2.hash('your-password'))"
# The hash contains literal $ characters (e.g. $argon2id$v=19$...) — Docker
# Compose's env_file: loader interpolates $VAR the same way a shell does,
# so escape every $ as $$ here or Compose silently corrupts the value into
# something unrelated (a warning, not an error) and every login fails.
# See docs/DEPLOYMENT.md section 2.2 for the verified reproduction/fix.
ADMIN_PASSWORD_HASH=

# ===== DATABASE =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yonixalpha
POSTGRES_USER=yonixalpha
POSTGRES_PASSWORD=
# If set, DATABASE_URL takes precedence over the discrete POSTGRES_* vars above.
DATABASE_URL=

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# ===== SOLANA (wired up starting Phase 2/3) =====
SOLANA_RPC_URL=
SOLANA_WS_URL=
SOLANA_RPC_BACKUP_URL=
SOLANA_WS_BACKUP_URL=

# ===== HELIUS (wired up starting Phase 2/3) =====
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# ===== JUPITER (wired up starting Phase 3/5) =====
JUPITER_API_KEY=

# ===== SOLANA WALLET (wired up starting Phase 3/5 — production keys must use a
# dedicated trading-only wallet, never an account holding unrelated funds) =====
SOLANA_WALLET_PRIVATE_KEY=

# ===== BINANCE =====
# Used by services/data-binance (public data, no key needed) and
# services/engine-binance-futures (account/orders — needs a real key with
# Futures trading permission once TRADING_ENABLED/LIVE_TRADING_ENABLED are
# both true; leave testnet=true and TRADING_ENABLED=false until you've
# verified the integration end-to-end).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# services/data-binance only: comma-separated symbols/stream types to
# ingest. Empty by default — the service logs a warning and does nothing
# until you opt in (see services/data-binance/app/main.py).
BINANCE_SYMBOLS=
BINANCE_STREAM_TYPES=kline_1m,aggTrade

# ===== SOLANA MIGRATION DETECTION (services/engine-solana-migration) =====
# name:programId pairs, comma-separated (e.g. raydium_v4:675kPX9...). Empty
# by default — Engine B ships with zero registered parsers regardless (see
# ARCHITECTURE_AUDIT.md and services/engine-solana-migration/README.md), so
# setting this alone does not make migration detection real.
MIGRATION_AMM_PROGRAM_IDS=

# ===== TELEGRAM (wired up starting Phase 11 — see docs/ALERTING.md) =====
# Both must be set for any alert to send; leaving either blank makes
# send_telegram_alert() a silent no-op everywhere it's called (kill switch
# engage/disengage, an auth lockout, any service's error/critical system
# events) — safe to leave unset in development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== FRONTEND =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ===== DOMAIN =====
PUBLIC_DOMAIN=http://localhost:3000

# ===== TLS (production only — see docs/DEPLOYMENT.md's certbot bootstrap
# step; not read by any Python service, only referenced in the manual
# certbot command the deploy runbook documents) =====
LETSENCRYPT_EMAIL=

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== TRADING SAFETY (both must be explicitly and separately enabled —
# see docs/DEPLOYMENT.md's "enabling live trading" section; defaults below
# are the only safe defaults) =====
TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
MAX_DAILY_LOSS=
MAX_POSITION_SIZE=
MAX_SLIPPAGE=
MAX_OPEN_POSITIONS=
