# YonixAlpha — environment template.
#
# Copy to .env for local development. In production this file lives only on
# the server (/opt/yonixalpha/.env) and is NEVER committed.
#
# WHAT GOES WHERE
#   .env (this file)   secrets and infrastructure: API keys, private keys,
#                      URLs, database/Redis wiring, the three trading locks.
#   database/dashboard strategy parameters, modes (OFF/PAPER/MANUAL/AUTO,
#                      global PAPER/MANUAL/LIVE), risk limits (position size,
#                      daily loss, leverage, token tax limits, slippage),
#                      word filters, custom rules, live-execution settings.
#                      Edited on the dashboard, validated, audited.
#
# Every variable below is read by the code (see docs/environment-variable-
# matrix.md for where). Values are placeholders: YOUR_... means "put your
# own value here"; empty means "optional / not used until you set it".
# At start-up the API validates each module's configuration (System Health →
# Configuration): an enabled module missing what it needs is
# CONFIGURATION_ERROR and cannot be switched to AUTO/LIVE; disabled modules
# never block the others.

# ============================================================== APPLICATION
APP_ENV=development
APP_NAME=YonixAlpha
# API bind address (apps/api Dockerfile CMD).
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Public URLs. NEXT_PUBLIC_API_URL is inlined into the frontend at BUILD
# time (docker compose --env-file .env ... build); the realtime WebSocket URL
# is derived from it. In production both are https://yourdomain.
NEXT_PUBLIC_API_URL=http://localhost:8000
PUBLIC_DOMAIN=http://localhost:3000
# Only used by the manual certbot command in docs/DEPLOYMENT.md.
LETSENCRYPT_EMAIL=

# ================================================================= DATABASE
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yonixalpha
POSTGRES_USER=yonixalpha
# Required: a long random password (`openssl rand -hex 24`). Left empty on
# purpose: the Postgres container refuses to start without one.
POSTGRES_PASSWORD=
# If set, takes precedence over the POSTGRES_* values above.
DATABASE_URL=

# ==================================================================== REDIS
REDIS_HOST=redis
REDIS_PORT=6379
# Required in production (`openssl rand -hex 24`).
REDIS_PASSWORD=
# If set, takes precedence over REDIS_HOST/PORT/PASSWORD.
REDIS_URL=

# =================================================================== SOLANA
# Required by the Pump.fun modules (discovery program-log stream, token and
# holder checks, PumpSwap pool reads, live execution). Either set the URLs,
# or only HELIUS_API_KEY (Helius mainnet URLs are then derived).
# HELIUS_RPC_URL / HELIUS_WS_URL are accepted as aliases.
SOLANA_RPC_URL=
SOLANA_WS_URL=
# Up to three backup RPCs, tried in this order whenever the primary fails
# (e.g. HTTP 429 rate limit). Use a different provider for each.
SOLANA_RPC_BACKUP_URL=
SOLANA_RPC_BACKUP_URL_2=
SOLANA_RPC_BACKUP_URL_3=
SOLANA_WS_BACKUP_URL=
# Optional: key for encrypting RPC provider URLs added in the dashboard
# (they embed API keys). Derived from JWT_SECRET when empty.
CONFIG_ENCRYPTION_KEY=
HELIUS_API_KEY=

# ============================================================= EVM CHAINS
# BSC (BNB Smart Chain, chain id 56) and Robinhood Chain (chain id 4663).
# Optional comma-separated RPC URLs, tried in order before each chain's public
# endpoints. Every URL's eth_chainId is checked before use.
BSC_RPC_URLS=
ROBINHOOD_RPC_URLS=
# One EVM account for BSC and Robinhood Chain. The address alone is enough
# (balances on the Wallets page). The private key is optional and server-only:
# never logged, never sent to the frontend, never stored in the database; if
# set it must match the address. EVM LIVE execution is not implemented.
EVM_WALLET_ADDRESS=
EVM_WALLET_PRIVATE_KEY=
# services/data-solana only: extra addresses (comma-separated) for the
# generic token_events table. Not needed by the Pump.fun pipeline.
SOLANA_WATCHED_ADDRESSES=
# services/engine-solana-migration only (generic AMM detector, ships with no
# parsers). Pump.fun migrations come from Pump.fun's own event. Leave empty.
MIGRATION_AMM_PROGRAM_IDS=
# LIVE Pump.fun execution wallet. Use a dedicated wallet holding only what
# you can lose. The private key signs locally in paper-trading's live worker;
# it is never logged, never sent to the frontend, never stored in the
# database. Formats: base58 64-byte secret or a solana-keygen JSON array.
# If WALLET_PUBLIC_KEY is set it must match. SOLANA_WALLET_PRIVATE_KEY is
# accepted as an older name.
WALLET_PUBLIC_KEY=
WALLET_PRIVATE_KEY=

# ====================================================== PUMPFUN / PUMPPORTAL
# Trading uses PumpPortal's Local Transaction API (trade-local): no key,
# YonixAlpha signs locally. The custodial Lightning API is not used.
# Discovery cross-check uses PumpPortal's data WebSocket; new-token and
# migration subscriptions are free. The key is ONLY for the metered
# token-trade subscription of mints you hold (charged per message by
# PumpPortal to the key's linked wallet). Leave empty to use free data only.
PUMPPORTAL_API_KEY=

# ================================================================== JUPITER
# Optional. With a key (portal.jup.ag) quotes use api.jup.ag/swap/v1; without
# one, the keyless lite-api.jup.ag, which Jupiter has deprecated. Used for
# cross-check quotes and fallback exit pricing, not for order execution.
JUPITER_API_KEY=

# Binance / Bybit / Hyperliquid / MT5 and the standalone bots' control APIs
# were removed with the futures, forex and grid features (branch
# archive/legacy-futures-forex-grid-2026-09-29). Their variables are ignored;
# delete them from an existing .env.

# ================================================================= TELEGRAM
# Both or neither. Alerts: kill switch, login lockouts, service errors,
# entries/exits, provider failures, approvals.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ======================================================================= ML
# No environment variables: models, training schedule, champion/challenger
# and drift thresholds live in the database (dashboard → ML). Legacy
# pre-gate paper entries only: simulated cost per leg in basis points.
PAPER_TRADING_PER_LEG_COST_BPS=0

# ================================================================= SECURITY
# JWT_SECRET: `openssl rand -hex 32`. Rotating it signs everyone out.
JWT_SECRET=
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH: an argon2 hash, never a plaintext password:
#   python -c "from passlib.hash import argon2; print(argon2.hash('your-password'))"
# Escape every $ as $$ in this file (Docker Compose interpolates $VAR).
ADMIN_PASSWORD_HASH=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
#
# TRADING LOCKS — live orders need ALL THREE: TRADING_ENABLED=true,
# LIVE_TRADING_ENABLED=true and PAPER_TRADING=false, plus global mode LIVE on
# the dashboard and the module in AUTO/MANUAL. These defaults are the only
# safe defaults; keep them during development.
TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
PAPER_TRADING=true
# LIVE EXECUTION SMOKE TEST — verifies wallet -> buy -> confirm -> position ->
# PnL -> sell -> confirm with a tiny amount of real SOL. Off by default. Even
# when true nothing happens until an admin arms a run on the Live page (admin
# password + typed confirmation); it never changes the global mode, and every
# buy passes the full safety gate against the live wallet. It also needs the
# three locks above open and a ready live order worker. MAX_SOL has no
# default: leave it empty and the test cannot be armed. MAX_TRADES counts all
# smoke-test buys ever made (raise it to run again). Not editable from the
# dashboard.
LIVE_SMOKE_TEST_ENABLED=false
LIVE_SMOKE_TEST_MAX_SOL=
LIVE_SMOKE_TEST_MAX_TRADES=1
# Legacy Phase 5 risk engine (pre-gate path) caps; the safety gate uses the
# database risk settings instead. Empty = not enforced by that legacy path.
MAX_DAILY_LOSS=
MAX_POSITION_SIZE=
MAX_OPEN_POSITIONS=
