# Copy this file to .env for local development. In production, this file
# lives only on the server (e.g. /opt/yonixalpha/.env) and is NEVER committed.
# See docs/DEPLOYMENT.md for where each secret comes from and how to
# generate the ones below that need it.

# ===== APPLICATION =====
APP_ENV=development
APP_NAME=YonixAlpha
APP_PORT=8000
APP_HOST=0.0.0.0

# ===== SECURITY =====
# JWT_SECRET: generate with `openssl rand -hex 32`. Rotating this invalidates all sessions.
JWT_SECRET=
# ADMIN_USERNAME: the sole operator account for this private platform.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH: an argon2 hash, NEVER a plaintext password. Generate with:
#   python -c "from passlib.hash import argon2; print(argon2.hash('your-password'))"
# The hash contains literal $ characters (e.g. $argon2id$v=19$...) — Docker
# Compose's env_file: loader interpolates $VAR the same way a shell does,
# so escape every $ as $$ here or Compose silently corrupts the value into
# something unrelated (a warning, not an error) and every login fails.
# See docs/DEPLOYMENT.md section 2.2 for the verified reproduction/fix.
ADMIN_PASSWORD_HASH=
# Optional; defaults shown.
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# ===== DATABASE =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yonixalpha
POSTGRES_USER=yonixalpha
POSTGRES_PASSWORD=
# If set, DATABASE_URL takes precedence over the discrete POSTGRES_* vars above.
DATABASE_URL=

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# ===== SOLANA RPC =====
# Needed for Pump.fun discovery (program-log WebSocket), token/holder checks,
# PumpSwap pool reads, and live execution. Either set the URLs, or set only
# HELIUS_API_KEY and the Helius mainnet URLs are derived from it.
# HELIUS_RPC_URL / HELIUS_WS_URL are accepted as aliases of SOLANA_RPC_URL /
# SOLANA_WS_URL.
SOLANA_RPC_URL=
SOLANA_WS_URL=
SOLANA_RPC_BACKUP_URL=
SOLANA_WS_BACKUP_URL=
HELIUS_API_KEY=
# Optional, services/data-solana only: extra addresses (comma-separated) to
# watch with logsSubscribe for the generic token_events table. The Pump.fun
# pipeline does not need it (engine-solana-discovery subscribes to the
# Pump.fun program itself).
SOLANA_WATCHED_ADDRESSES=

# ===== JUPITER (optional) =====
# Used only as a cross-check quote for migrated tokens and a fallback exit
# price; PumpSwap pool data is read from chain.
JUPITER_API_KEY=

# ===== LIVE WALLET (Pump.fun live execution only) =====
# Use a dedicated trading-only wallet holding only what you are prepared to
# lose — never a wallet with unrelated funds. The private key signs
# transactions locally inside paper-trading's live worker; it is never sent
# anywhere, never logged, never shown in the dashboard. Accepted formats:
# base58 64-byte secret (Phantom/Solflare export) or the JSON byte array of a
# solana-keygen file. If WALLET_PUBLIC_KEY is set it must match the key.
# SOLANA_WALLET_PRIVATE_KEY is accepted as an older name.
# Nothing is traded with this key unless TRADING_ENABLED=true,
# LIVE_TRADING_ENABLED=true AND PAPER_TRADING=false (below), and the global
# mode is set to LIVE in the dashboard.
WALLET_PUBLIC_KEY=
WALLET_PRIVATE_KEY=
# Live execution settings (slippage, priority fee, SOL reserve, ...) are NOT
# environment variables: they live in the database and are edited on the
# dashboard's Live Execution page.

# ===== BINANCE =====
# Used by services/data-binance (public data, no key needed) and
# services/engine-binance-futures (account/orders — needs a real key with
# Futures trading permission once TRADING_ENABLED/LIVE_TRADING_ENABLED are
# both true; leave testnet=true and TRADING_ENABLED=false until you've
# verified the integration end-to-end).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ===== BYBIT (optional, READ-ONLY key) =====
# Enables the Bybit page's balance/positions/orders/fills. Create the key
# with read-only permission — nothing here places orders. Market data works
# without it.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ===== HYPERLIQUID (optional) =====
# A public account address is enough for read-only account views. Never put
# a private key here; none is used.
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET=false
# services/data-binance only: comma-separated symbols/stream types to
# ingest. Empty by default — the service logs a warning and does nothing
# until you opt in (see services/data-binance/app/main.py).
BINANCE_SYMBOLS=
BINANCE_STREAM_TYPES=kline_1m,aggTrade

# ===== GENERIC AMM MIGRATION DETECTOR (services/engine-solana-migration) =====
# NOT part of the Pump.fun sniper. Pump.fun migrations are detected from
# Pump.fun's own migration event in the program-log stream, and only
# pump-stream candidates ever reach the safety gate. This older generic
# detector ships with no parsers; leave it empty.
MIGRATION_AMM_PROGRAM_IDS=

# ===== TELEGRAM (wired up starting Phase 11 — see docs/ALERTING.md) =====
# Both must be set for any alert to send; leaving either blank makes
# send_telegram_alert() a silent no-op everywhere it's called (kill switch
# engage/disengage, an auth lockout, any service's error/critical system
# events) — safe to leave unset in development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== FRONTEND =====
# In production, set this to your real domain (e.g.
# https://yourdomain.com) BEFORE the first
# `docker compose ... up --build` — it gets inlined into the frontend's
# JS bundle at build time via web.build.args in docker-compose.yml, which
# needs `docker compose --env-file .env ...` to read this file correctly
# (see docs/DEPLOYMENT.md section 2.3). Changing it later means
# rebuilding the web image, not just editing .env and restarting.
# The realtime WebSocket URL is derived from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===== DOMAIN =====
PUBLIC_DOMAIN=http://localhost:3000

# ===== TLS (production only — see docs/DEPLOYMENT.md's certbot bootstrap
# step; not read by any Python service, only referenced in the manual
# certbot command the deploy runbook documents) =====
LETSENCRYPT_EMAIL=

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== TRADING SAFETY (both must be explicitly and separately enabled —
# see docs/DEPLOYMENT.md's "enabling live trading" section; defaults below
# are the only safe defaults) =====
TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
# Independent third lock: while true, executable decisions only ever go to
# the paper engine. Live needs both flags above true AND this false.
PAPER_TRADING=true
# Legacy Phase 7 paper entries only (not the gate-driven Pump.fun path,
# whose fills are simulated against the curve/pool): cost charged per leg.
# PAPER_TRADING_PER_LEG_COST_BPS=0
MAX_DAILY_LOSS=
MAX_POSITION_SIZE=
MAX_SLIPPAGE=
MAX_OPEN_POSITIONS=
